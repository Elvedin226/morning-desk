# Local Python environment - rebuilt from requirements.txt
.venv/
__pycache__/
*.pyc

# Generated data. Regenerable, grows daily, and the IV history is large.
# dashboard.html is deliberately NOT ignored: GitHub Actions commits it, and the
# Claude routine reads it back from raw.githubusercontent.com.
data_cache/

# Windows Task Scheduler wrappers - local paths, useless on a runner
run-*.bat

# ...except the paper account. This is the whole record of what the bot did and
# it must survive between GitHub Actions runs, which share nothing but the repo.
# Ignoring it would restart the account from scratch every morning.
!data_cache/
data_cache/*
!data_cache/portfolio.json
# Gamma snapshots accumulate one row a day and only become testable with
# enough of them - losing them to a fresh runner would reset the experiment.
!data_cache/gex_history.jsonl
